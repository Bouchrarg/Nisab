# Corpus pipeline — sources brutes et backups, pas besoin de vivre dans Git.
# corpus.db lui-même est déjà couvert par *.db ci-dessus ; ceci couvre les
# backups horodatés (corpus.db.backup-XXXXXXXX, ne finit pas en .db) et les
# PDF sources (CGI/BO), utilisés uniquement par l'ingestion locale.
corpus-pipeline/data/*.db.backup-*
corpus-pipeline/data/raw_pdfs/

