# Copie ce fichier en `.env` pour le dev local. Sur Render, ces mêmes clés
# vont dans le dashboard (Environment) — jamais dans le repo, jamais commit
# avec de vraies valeurs (`.env` et `*.env` sont dans .gitignore, ce fichier
# `.env.example` y échappe volontairement car il ne contient aucun secret).

# ── Base de données (Supabase/Postgres + pgvector) ──────────────────────────
# Rôle applicatif `nisab_app` — délibérément PAS propriétaire des tables, sinon
# Postgres n'applique pas les policies RLS au propriétaire et l'isolation
# multi-tenant tombe. Utilisé par toutes les routes tenant-scoped (get_tenant_db).
DATABASE_URL=postgresql://nisab_app:xxx@xxx.supabase.co:5432/postgres

# Rôle superuser — nécessaire pour /admin (vue plateforme, toutes organisations,
# ce qu'une policy RLS scopée par organisation ne peut structurellement pas
# faire) ET pour les migrations Alembic (DDL). Jamais utilisé par les routes
# tenant-scoped normales.
ADMIN_DATABASE_URL=postgresql://postgres:xxx@xxx.supabase.co:5432/postgres

# ── LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_KEY=

# ── Auth / secrets ───────────────────────────────────────────────────────
# JWT HS256 (access 30 min / refresh 14 jours).
JWT_SECRET=

# Chiffrement Fernet des identifiants ERP stockés en base (secrets_store.py).
# Volontairement DISTINCTE de JWT_SECRET : faire tourner le secret JWT ne doit
# pas rendre illisibles les identifiants Odoo déjà enregistrés. Ne JAMAIS la
# changer une fois des identifiants Odoo mémorisés (ils deviennent illisibles).
NISAB_SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────
# Liste séparée par virgules, un .strip() par élément côté main.py donc les
# espaces après une virgule ne cassent rien. En local : localhost:5173. Sur
# Render : l'URL Vercel du frontend une fois déployé.
NISAB_ALLOWED_ORIGINS=http://localhost:5173

# ── Corpus (ingestion locale uniquement) ────────────────────────────────
# Lu SEULEMENT par les scripts one-off (scripts/ingest_to_supabase.py et
# consorts) — jamais par le backend en prod (vectorstore.py lit DATABASE_URL
# directement). Inutile de la définir sur Render.
CORPUS_DB_PATH=
